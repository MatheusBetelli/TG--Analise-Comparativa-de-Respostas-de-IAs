OPENROUTER_API_KEY=sk-or-v1-COLOQUE_SUA_CHAVE_AQUI

# Modelos fixos sugeridos para a coleta. Confirme no OpenRouter antes da coleta oficial.
OPENAI_MODEL=openai/gpt-5.4
GEMINI_MODEL=google/gemini-3.6-flash
CLAUDE_MODEL=anthropic/claude-sonnet-4.6

INPUT_CSV=data/input/prompts_vulnerabilidade.csv
OUTPUT_CSV=data/output/respostas_ias.csv

MAX_TOKENS=600
MAX_RETRIES=3
DELAY_BETWEEN_CALLS=1.0
