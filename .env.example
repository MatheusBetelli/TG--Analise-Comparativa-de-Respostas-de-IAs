OPENROUTER_API_KEY=sk-or-v1-seu_token_aqui

# Modelos fixos sugeridos para a coleta. Confirme no OpenRouter antes da coleta oficial.
OPENAI_MODEL=openai/gpt-5.4
CLAUDE_MODEL=anthropic/claude-sonnet-4.6
META_MODEL=meta-llama/llama-4-maverick

INPUT_CSV=data/input/mensagens_tg.csv
OUTPUT_CSV=data/output/respostas_ias_tg.csv

MAX_TOKENS=600
MAX_RETRIES=3
DELAY_BETWEEN_CALLS=1.0
